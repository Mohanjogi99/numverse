{
  "name": "number-story-functions",
  "version": "1.0.0",
  "description": "Firebase Cloud Functions for Number Story",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "firebase-admin": "^13.1.0",
    "firebase-functions": "^6.3.2",
    "openai": "^7.30.1",
    "razorpay": "^2.9.8"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "typescript": "~5.7.2"
  }
}
