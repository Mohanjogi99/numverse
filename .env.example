# Number Story - Environment Configuration
# NEVER expose backend secrets (OPENAI_API_KEY, RAZORPAY_KEY_SECRET, RAZORPAY_WEBHOOK_SECRET) to client-side code

# ----------------------------------------------------
# 1. Razorpay Payment Gateway (Test / Live)
# ----------------------------------------------------
# Public Razorpay Key ID (Accessible to frontend Vite via VITE_ prefix)
VITE_RAZORPAY_KEY_ID=rzp_test_your_test_key_id

# Backend-only Razorpay Secret and Webhook Secret (NEVER prefix with VITE_)
RAZORPAY_KEY_ID=rzp_test_your_test_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ----------------------------------------------------
# 2. OpenAI Configuration (Backend Only)
# ----------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
AI_REPORT_PROMPT_VERSION=1.0
AI_REPORT_MAX_OUTPUT_TOKENS=3000
AI_REPORT_MAX_RETRIES=2

# ----------------------------------------------------
# 3. Firebase Configuration (Client Public)
# ----------------------------------------------------
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
